+/* Byte-level seek within the currently selected title.
+ *
+ * mpv 0.36 never sets s->seek for the bluray stream, so s->seekable stays
+ * false. demux_disc's d_seek() resets the lavf sub-demuxer with
+ * demux_seek(slave, 0, SEEK_FACTOR | SEEK_FORCE), which ends up calling
+ * stream_seek(s, 0). Without byte seeking that fails with
+ * "Cannot seek backward in linear streams!", so the sub-demuxer is left at its
+ * old position and the post-seek data is fed into stale decoder state. The
+ * result is bogus PTS jumps ("PTS discontinuity"), corrupt NAL units,
+ * VideoToolbox -12909, "Error while decoding frame (hardware decoding)!"
+ * and eventually "Error decoding audio." (DTS block decode failure).
+ */
+static int bluray_stream_seek(stream_t *s, int64_t pos)
+{
+    struct bluray_priv_s *b = s->priv;
+    if (pos < 0)
+        return 0;
+    // bd_seek(): byte position within the currently selected title.
+    // Returns the new position (0 is valid) or -1 on error.
+    return bd_seek(b->bd, pos) >= 0;
+}
