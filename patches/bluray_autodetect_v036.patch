+/* Backported from mpv 0.40 (demux/demux_lavf.c).
+ *
+ * Drop everything the lavf demuxer has buffered, WITHOUT doing a low level
+ * byte seek on the underlying stream. demux_disc.c used to force-reset its
+ * lavf sub-demuxer with demux_seek(slave, 0, SEEK_FACTOR | SEEK_FORCE), which
+ * ends up calling stream_seek(s, 0). For Blu-ray that byte seek is meaningless
+ * (libbluray owns the read position; real seeking goes through bd_seek_time()),
+ * and forwarding it to bd_seek() drags libbluray back to byte 0 of the ISO,
+ * i.e. the UDF metadata area. Observed symptoms:
+ *   "reset to time: 12.716444"                (constant, any seek target)
+ *   "playback restart complete @ 13.507944"   (playback rewinds to start)
+ *   "PES packet size mismatch" / "Packet corrupt" / "PTS discontinuity"
+ *     -> h264 corruption, VideoToolbox -12909, "Error decoding audio."
+ */
+static void demux_drop_buffers_lavf(demuxer_t *demuxer)
+{
+    lavf_priv_t *priv = demuxer->priv;
+    av_seek_frame(priv->avfc, -1, 0, 1);
+    demux_flush(demuxer);
+    stream_drop_buffers(priv->stream);
+    avio_flush(priv->avfc->pb);
+    avformat_flush(priv->avfc);
+}
+
 const demuxer_desc_t demuxer_desc_lavf = {
     .name = "lavf",
     .desc = "libavformat",
@@ -1431,4 +1455,5 @@
     .close = demux_close_lavf,
     .seek = demux_seek_lavf,
     .switched_tracks = demux_lavf_switched_tracks,
+    .drop_buffers = demux_drop_buffers_lavf,
 };
