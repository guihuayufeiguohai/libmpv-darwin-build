+/* ---------- auto-detect Blu-ray ISO over HTTP(S) ---------- */
+/*
+ * Open http(s) Blu-ray images directly, including extension-less URLs.
+ * Returns STREAM_UNSUPPORTED on miss so stream_info_ffmpeg takes over.
+ */
+static int bdmv_http_stream_open(stream_t *stream)
+{
+    // Fast path: skip well-known non-disc extensions, zero extra network cost.
+    static const char *const skip_ext[] = {
+        ".mp4", ".m4v", ".mkv", ".webm", ".mov", ".avi", ".flv",
+        ".ts", ".m2ts", ".m4s",
+        ".m3u8", ".mpd", ".m3u", ".pls",
+        ".mp3", ".m4a", ".aac", ".flac", ".ogg", ".opus", ".wav",
+        ".srt", ".ass", ".ssa", ".vtt", ".json", ".xml", NULL
+    };
+
+    const char *url = stream->url ? stream->url : "";
+    // Only look at the part before '?' / '#', so that ".iso?token=..." matches.
+    bstr base = { (uint8_t *)url, strcspn(url, "?#") };
+    for (int i = 0; skip_ext[i]; i++) {
+        if (bstr_case_endswith(base, bstr0(skip_ext[i])))
+            return STREAM_UNSUPPORTED;
+    }
+
+    if (!stream->access_references)
+        return STREAM_UNSUPPORTED;
+
+    struct bluray_priv_s *priv = talloc_zero(stream, struct bluray_priv_s);
+    stream->priv = priv;
+    priv->cfg_title = BLURAY_DEFAULT_TITLE;
+    priv->cfg_device = talloc_strdup(priv, url);
+
+    // Routes to open_bd_http() when cfg_device is http(s).
+    int r = bluray_stream_open_internal(stream);
+    if (r != STREAM_OK) {
+        talloc_free(priv);
+        stream->priv = NULL;
+        return STREAM_UNSUPPORTED;
+    }
+    MP_INFO(stream, "Blu-ray ISO over HTTP detected.\n");
+    return r;
+}
+
+const stream_info_t stream_info_bdmv_http = {
+    .name = "bdmv-http",
+    .open = bdmv_http_stream_open,
+    .protocols = (const char *const[]){ "http", "https", NULL },
+    // STREAM_ORIGIN_NET (not UNSAFE): media_kit's loadlist rewrites entry
+    // origin to STREAM_ORIGIN_FS; check_origin(FS, UNSAFE) == 0 would be
+    // rejected, while check_origin(FS, NET) passes.
+    .stream_origin = STREAM_ORIGIN_NET,
+};
