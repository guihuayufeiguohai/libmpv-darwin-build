 // get the coefficients of the yuv -> rgb conversion matrix
+// IPT-C2 step 3: convert linear LMS to linear RGB.
+//
+// This is the inverse of (crosstalk * HPE_XYZ2LMS * RGB2XYZ), evaluated for
+// BT.2020 primaries at D65 -- which is what Dolby Vision Profile 5 is
+// defined against. Computed numerically:
+//   crosstalk(4%) = {0.92,0.04,0.04},{0.04,0.92,0.04},{0.04,0.04,0.92}
+//   HPE XYZ->LMS  = { 0.40024, 0.70760, -0.08081},
+//                   {-0.22630, 1.16532,  0.04570},
+//                   { 0.00000, 0.00000,  0.91822}
+// (both from libplacebo pl_ipt_rgb2lms)
+//
+// Because IPT-C2 is fixed to BT.2020, this is a constant matrix.
+void mp_get_ipt_lms2rgb_matrix(float m[3][3])
+{
+    static const float lms2rgb[3][3] = {
+        {  3.4368148f, -2.5067738f,  0.0699519f},
+        { -0.7910582f,  1.9836017f, -0.1925448f},
+        { -0.0257268f, -0.0991418f,  1.1248741f},
+    };
+    for (int i = 0; i < 3; i++)
+        for (int j = 0; j < 3; j++)
+            m[i][j] = lms2rgb[i][j];
+}
+
 void mp_get_csp_matrix(struct mp_csp_params *params, struct mp_cmat *m)
 {
     enum mp_csp colorspace = params->color.space;
@@ -822,6 +847,33 @@
         };
         break;
     }
+    case MP_CSP_IPT_C2: {
+        // Dolby Vision Profile 5 (IPT-PQ-C2, ITU-T H.273 code 15).
+        //
+        // This is NOT an affine YCbCr matrix. IPT-C2 splits into two 3x3
+        // matrices with the PQ EOTF in between:
+        //
+        //   1. IPT -> L'M'S'   (matrix below; operates on PQ-encoded values)
+        //   2. PQ EOTF         (per-channel, handled by the normal TRC path)
+        //   3. LMS  -> linear RGB (see mp_get_ipt_lms2rgb_matrix(); applied
+        //      separately in pass_color_map(), AFTER linearization)
+        //
+        // Values taken from libplacebo's pl_ipt_ipt2lms (Ebner & Fairchild
+        // IPT 1998, numerically inverted). Unlike BT.2100 ICtCp, IPT-C2's
+        // LMS space is HPE XYZ->LMS with 4% cone crosstalk, hence the
+        // different coefficients.
+        *m = (struct mp_cmat) {
+            {{ 1.0,  0.0975689,  0.205226},
+             { 1.0, -0.1138760,  0.133217},
+             { 1.0,  0.0326151, -0.676887}},
+        };
+        // IPT-C2 is carried full-range: I spans [0,1] while P and T are
+        // offset-binary centred at 0.5. Limited range would clamp I and
+        // mis-centre P/T, so force full range regardless of what the
+        // container claims.
+        levels_in = MP_CSP_LEVELS_PC;
+        break;
+    }
     default:
         MP_ASSERT_UNREACHABLE();
     };
